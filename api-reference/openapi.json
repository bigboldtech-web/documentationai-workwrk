sponses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}},"tags":["People"],"operationId":"postPeople"}},"/kras":{"get":{"summary":"List KRAs","responses":{"200":{"description":"OK"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}},"tags":["Alignment"],"operationId":"getKras","description":"Requires a key with the **READ** scope (ADMIN satisfies every scope)."},"post":{"summary":"Create a KRA","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["name"],"properties":{"name":{"type":"string"},"description":{"type":"string"},"category":{"type":"string"},"roleId":{"type":"string"}}}}}},"responses":{"201":{"description":"Created"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}},"tags":["Alignment"],"operationId":"postKras","description":"Requires a key with the **WRITE** scope (ADMIN satisfies every scope)."}},"/kpis":{"get":{"summary":"List KPIs","responses":{"200":{"description":"OK"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#/components/responses/Forbidden"},"429":{"$ref":"#/components/responses/RateLimited"}},"tags":["Alignment"],"operationId":"getKpis","description":"Requires a key with the **READ** scope (ADMIN satisfies every scope)."},"post":{"summary":"Create a KPI","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["kraId","name","targetValue"],"properties":{"kraId":{"type":"string"},"name":{"type":"string"},"description":{"type":"string"},"targetValue":{"type":"number"},"unit":{"type":"string","default":"#"},"frequency":{"type":"string","default":"monthly"},"weight":{"type":"number","default":1}}}}}},"responses":{"201":{"description":"Created"},"401":{"$ref":"#/components/responses/Unauthorized"},"403":{"$ref":"#